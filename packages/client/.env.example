VITE_SIGNALING_URL=http://localhost:4000

# Origem YouTube do player de música. Ligada por padrão.
# Com `false`, o link do YouTube deixa de ser aceito e nenhum script da Google é
# carregado. Vale desligar onde a promessa de "nenhum terceiro" for absoluta: o
# player do YouTube roda no navegador de **cada** participante (é a única forma
# tecnicamente possível), então a Google vê o IP de todos e o que está tocando.
# Arquivo local e URL direta de áudio não têm esse custo.
VITE_ENABLE_YOUTUBE=true

# Telemetria anônima. Ligada por padrão.
# Com `false` (a **string**), nenhuma requisição de telemetria sai do
# navegador: nem page view, nem fim de sessão, em nenhuma das três telas. O
# beacon vai para o próprio servidor de sinalização (`POST /telemetry`), nunca
# para o collector — o navegador não conhece o endereço da stack de
# monitoramento. Nenhum cookie, nenhum localStorage, nenhum identificador de
# aba ou de sala é criado, e é por isso que não há banner de consentimento.
#
# Atenção: `import.meta.env` é resolvido em **build time**. No Docker isto
# precisa ser build arg (já está no docker-compose.yml); definir a variável no
# runtime do nginx não tem efeito nenhum.
VITE_TELEMETRY_ENABLED=true
