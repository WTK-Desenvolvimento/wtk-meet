{
  "name": "wtk-meet-server",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "description": "Ephemeral WebRTC signaling server for wtk-meet (no persistence, in-memory rooms only)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --import ../../tools/registerTs.mjs src/index.ts",
    "test": "node --import ../../tools/registerTs.mjs --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=26"
  }
}
