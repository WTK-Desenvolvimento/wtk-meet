PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Cloudflare TURN (https://dash.cloudflare.com → Calls → TURN)
CF_TURN_TOKEN_ID=your_token_id_here
CF_TURN_API_TOKEN=your_api_token_here
CF_TURN_TTL=86400

# ── Telemetria (OTLP) ────────────────────────────────────────────────────
# Ausente ⇒ telemetria **desligada por inteiro**: nenhum MeterProvider é
# criado, nenhum timer é armado, nenhum socket é aberto. O servidor sobe
# normalmente, imprime um aviso no boot e /health reporta
# telemetry.enabled:false. POST /telemetry continua respondendo 204.
# Endereço **base** do collector, sem /v1/metrics — o servidor acrescenta o
# caminho do sinal. Ver infra/otel/collector.example.yaml.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Autenticação do collector, no formato `chave=valor,chave2=valor2`. Nunca
# aparece em /health nem em log.
OTEL_EXPORTER_OTLP_HEADERS=

# Atributo `service.name` do resource. O resource é montado explicitamente e
# tem só isto e `service.version`: nada de host.name, process.pid ou
# process.command_args, que levariam hostname e caminho do filesystem do
# operador para dentro da stack de monitoramento.
OTEL_SERVICE_NAME=wtk-meet-server

# Intervalo do PeriodicExportingMetricReader, em milissegundos.
OTEL_METRIC_EXPORT_INTERVAL_MS=60000

# Teto de beacons por janela de 60s, por IP truncado (IPv4 → /24, IPv6 → /48).
# O IP truncado é chave de um Map descartado a cada janela: nunca vai para log,
# nunca vira atributo de métrica e nunca sai do processo. Estouro responde 429
# sem corpo, contado como wtk_telemetry_beacons_total{outcome="rejected"}.
TELEMETRY_RATE_LIMIT_PER_MINUTE=120
