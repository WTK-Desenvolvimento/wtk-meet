PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# STUN self-hosted (coturn) — anunciado ao client via GET /turn-credentials
STUN_URL=stun:localhost:3478

# TURN self-hosted (coturn) — deixe TURN_SHARED_SECRET vazio para desabilitar
# TURN (client cai para STUN-only, funciona só quando P2P direto é possível).
# Deve ser idêntico ao static-auth-secret em infra/coturn/turnserver.conf.
TURN_URLS=turn:localhost:3478,turns:localhost:5349
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=3600
